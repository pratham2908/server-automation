# --- One AI gateway ---
# Every AI call goes through One AI, which holds the Vertex credentials, prices the call and
# returns its cost. This service holds no provider credential of its own.
#
# The deployed gateway. Point this at http://localhost:4199 only when you are running One AI
# locally; there is no other reason to change it.
ONE_AI_URL=https://one-ai-1030625682382.us-central1.run.app
# This application's client key. Ask the platform owner; never commit a real one.
ONE_AI_API_KEY=

# Still required, and not for AI: the GCS staging client authenticates with it and takes its
# project from those credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. On a developer machine the client probes http://localhost:4199/health once and uses a
# local gateway if one answers, so ONE_AI_URL above can stay pointed at production everywhere.
# ONE_AI_LOCAL_URL moves that address; ONE_AI_PREFER_LOCAL=0/1 overrides the dev/production sniffing.
# ONE_AI_LOCAL_URL=http://localhost:4199
# ONE_AI_PREFER_LOCAL=1
